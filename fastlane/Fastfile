default_platform(:ios)
platform :ios do
  desc "TestFlight 업로드"
  lane :beta do
    api_key = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_filepath: "../../AuthKey.p8")
    sigh(api_key: api_key, app_identifier: "com.campusdoit.app", readonly: false)   # 프로비저닝 자동 발급/갱신
    increment_build_number(build_number: ENV["GITHUB_RUN_NUMBER"] || "1")
    build_app(workspace: "App.xcworkspace", scheme: "App", export_method: "app-store", clean: false)
    pilot(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
